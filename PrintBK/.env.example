# ── PrintBK Catalyst Function Environment Variables ─────────────────────────
# Configure these variables in Zoho Catalyst Console under Compute > Functions > api > Environment Variables
# NEVER commit the real values to git or expose them to the client bundle.

# Staff Counter Authentication Token (Used by staff application)
STAFF_TOKEN=your_secure_random_staff_token_here

# Scheduler Shared Secret (Used by Catalyst Cron for POST /cron/cleanup)
CRON_SECRET=your_secure_random_cron_secret_here

# Server-Authoritative Direct UPI Intent Parameters
UPI_ID=your_upi_vpa_here@bank
UPI_PAYEE_NAME=PrintBK HKBK

# Dormant Razorpay Online Gateway (Leave empty until online gateway is activated)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
